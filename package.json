{
  "name": "dsh-open-code-review",
  "version": "0.12.6",
  "private": true,
  "description": "把阿里 OpenCodeReview(ocr) 接进 DSH：模型可调用的 ocr_review/ocr_status 工具、/ocr-review 命令、按需评审（回合尾部的「启动代码审核」按钮 —— v0.11.0 起只在检测到本回合有改动时才出现 —— 加运行时 skill），三档引擎（v0.10.0 起出厂默认 ocr 流水线：要真调 LLM、按 tokens 计费，但跑前先给一条本次规模的成本预估；delegate 不调 LLM、几秒出规格，仍可显式选择），结果按文件逐条列出「文件:行 [严重程度] 问题」并给每个失败码附「下一步」。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-review",
    "open-code-review",
    "ocr"
  ],
  "author": "xinyangGL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyangGL/dsh-open-code-review.git"
  },
  "homepage": "https://github.com/xinyangGL/dsh-open-code-review#readme",
  "bugs": {
    "url": "https://github.com/xinyangGL/dsh-open-code-review/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@alibaba-group/open-code-review": "1.12.13"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./test/*": "./test/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "config.example.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/host-contract.md",
    "docs/pretest-gate-safety-design.md",
    "docs/settings-basic.png",
    "docs/settings-advanced.png"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/killswitch-smoke.mjs && node test/host-contract.mjs && node test/bridge-smoke.mjs && node test/client-smoke.mjs && node test/cordis-inject.mjs && node test/pack-check.mjs",
    "test:pack": "node test/pack-check.mjs"
  },
  "_comment_files": "files 只发 README 真正链到的文档与图；内部计划与自评（maturity-assessment / ROADMAP / *-plan-*.md）留在仓库里、靠 GitHub 绝对链接引用 —— 断言见 test/pack-check.mjs（npm run test:pack）。",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "host": {
      "dsh": ">=0.2.0",
      "testedWith": {
        "dsh": "0.2.0-rc.2 (desktop)",
        "node": "20 / 22 / 24",
        "ocr": "1.12.12 / 1.12.13"
      },
      "capabilities": [
        "tools.register",
        "subprocess.spawn",
        "subprocess.resolveExecutable",
        "commands.register",
        "credentials.resolve",
        "events.loader/volatile-update",
        "inject.llm",
        "inject.skills",
        "client.slots"
      ]
    }
  },
  "license": "MIT"
}
