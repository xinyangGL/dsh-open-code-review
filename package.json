{
  "name": "dsh-open-code-review",
  "version": "0.6.0",
  "private": true,
  "description": "把阿里 OpenCodeReview(ocr) 接进 DSH：模型可调用的 ocr_review/ocr_status 工具、/ocr-review 命令、按需评审（回合尾部的「启动代码审核」按钮 + 运行时 skill，出厂默认不自动评审）、评审先于测试（preTest=remind/gate 把评审接进「跑测试之前」）、三档引擎（ocr 流水线 / delegate 委派 / 独立的只读评审子 agent），结果按文件逐条列出「文件:行 [严重程度] 问题」，每次评审都有实时进度（Jobs 面板 + 会话内进度行、可停止）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "code-review",
    "open-code-review",
    "ocr"
  ],
  "author": "xinyangGL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyangGL/dsh-open-code-review.git"
  },
  "homepage": "https://github.com/xinyangGL/dsh-open-code-review#readme",
  "bugs": {
    "url": "https://github.com/xinyangGL/dsh-open-code-review/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./test/*": "./test/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "config.example.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/job-smoke.mjs && node test/reviewer-smoke.mjs && node test/bridge-smoke.mjs && node test/client-smoke.mjs && node test/cordis-inject.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT"
}
